{
  "redirects": [
    {
      "source": "/admin/reset",
      "destination": "/admin",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/carta", "destination": "/index.html" },
    { "source": "/para-llevar", "destination": "/index.html" },
    { "source": "/reservas", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "server/**/*"
    }
  }
}