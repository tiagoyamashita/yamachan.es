{
  "redirects": [
    {
      "source": "/admin/reset",
      "destination": "/admin",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/carta", "destination": "/index.html" },
    { "source": "/para-llevar", "destination": "/index.html" },
    { "source": "/reservas", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/mesa/(.*)", "destination": "/index.html" },
    { "source": "/api/admin/:match*", "destination": "/api/admin" },
    { "source": "/api/reservations/:match*", "destination": "/api/reservations" },
    { "source": "/api/takeout/:match*", "destination": "/api/takeout" },
    { "source": "/api/mesa/:match*", "destination": "/api/mesa" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "{server,src}/**/*"
    }
  }
}