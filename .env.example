# Instagram Graph API long-lived user token (required for real top comments).
# Without it, the site still loads post images + captions via public embeds.
INSTAGRAM_ACCESS_TOKEN=
# Fallback permalinks when none are saved in Admin → Instagram (comma/newline, up to 5).
INSTAGRAM_POST_URLS=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Must match the value seeded in Supabase private.yamachan_settings (see supabase/setup-admin.sql)
ADMIN_WRITE_SECRET=
# Admin password reset via Resend (https://resend.com)
ADMIN_EMAIL=
# Public site URL used in reset links, e.g. https://yamachan.es
ADMIN_SITE_URL=
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender on your domain (must be verified at https://resend.com/domains first)
# e.g. Yama-Chan <noreply@yamachan.es>
RESEND_FROM=
GLOBALLYBOOKED_API_BASE=https://www.globallybooked.com
GLOBALLYBOOKED_RESTAURANT_SLUG=yama-chan-alicante
GLOBALLYBOOKED_RESTAURANT_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHOD_CONFIGURATION=
